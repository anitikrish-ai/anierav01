# ---------------------------------------------------------------------------
# AniEra — environment variables
# Copy this file to `.env` and fill in real values.
# All values below are safe placeholders; never commit real credentials.
# ---------------------------------------------------------------------------

# Backend (Supabase / Lovable Cloud) — from your project's API settings.
# The publishable/anon key is safe to ship to the browser; RLS protects data.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Same values, exposed to the server runtime (SSR + server functions).
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
SUPABASE_PROJECT_ID="your-project-ref"

# Server-only. Bypasses row-level security — never expose to the client and
# never prefix it with VITE_. Leave unset unless a server function needs it.
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Public anime metadata comes from the Jikan v4 API (no key required) with an
# AniList GraphQL fallback (no key required). Nothing to configure here.
